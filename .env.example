# Server Configuration
PORT=7575
NODE_ENV=production

# Session Secret (GANTI dengan random string yang panjang)
SESSION_SECRET=your-super-secret-random-session-key-change-this

# Database
DB_PATH=./data/streamflow.db

# YouTube OAuth Credentials (dari Google Cloud Console)
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret

# Base URL (URL publik aplikasi Anda)
# Development: http://localhost:7575
# Production: https://yourdomain.com
BASE_URL=http://localhost:7575