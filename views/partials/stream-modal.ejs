<!-- New Stream Modal Redesign (Grid + Auto Assign) -->
<style>
    /* Force Dark Mode for Autofill */
    #newStreamModal input:-webkit-autofill,
    #newStreamModal input:-webkit-autofill:hover,
    #newStreamModal input:-webkit-autofill:focus,
    #newStreamModal input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 30px #111827 inset !important;
        -webkit-text-fill-color: #e5e7eb !important;
        caret-color: white;
        transition: background-color 5000s ease-in-out 0s;
    }
</style>

<div id="newStreamModal"
    class="fixed inset-0 bg-black/90 z-50 hidden flex items-center justify-center backdrop-blur-sm">
    <div
        class="bg-[#121212] w-full max-w-4xl shadow-2xl border-x border-gray-800 flex flex-col h-full text-gray-300 font-sans">

        <!-- Header -->
        <div class="px-6 py-2 flex justify-between items-center border-b border-gray-800 bg-[#18181b] flex-shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center">
                    <i class="ti ti-video text-emerald-500 text-lg"></i>
                </div>
                <div>
                    <h2 class="text-white font-bold text-base" id="streamModalTitle">Create New Stream</h2>
                    <p class="text-[10px] text-gray-500" id="streamModalDescription">Setup single stream configuration
                        manually</p>
                </div>
            </div>
            <button type="button" onclick="closeStreamModalV2()"
                class="text-gray-400 hover:text-white transition-colors">
                <i class="ti ti-x text-xl"></i>
            </button>
        </div>

        <!-- Scrollable Content -->
        <form id="newStreamForm" action="/api/streams" method="POST"
            class="flex-1 overflow-y-auto custom-scrollbar p-4 grid grid-cols-1 lg:grid-cols-12 gap-5"
            autocomplete="off">
            <input type="hidden" name="videoId" id="selectedVideoId" required>
            <input type="hidden" name="playlistId" id="selectedPlaylistId">
            <input type="hidden" name="thumbnailId" id="selectedThumbnailId">
            <input type="hidden" name="channelId" value="<%= typeof channel !== 'undefined' ? channel.id : '' %>">

            <!-- LEFT COLUMN (Stream Details & Config) -->
            <div class="lg:col-span-6 space-y-6">

                <!-- DETAIL STREAM SECTION -->
                <div class="rounded-xl border border-gray-800 bg-[#18181b] p-5">
                    <div
                        class="flex items-center gap-2 mb-4 text-emerald-500 font-bold text-xs tracking-wider uppercase">
                        <i class="ti ti-info-circle"></i> Detail Stream
                    </div>

                    <!-- Stream Title -->
                    <div class="mb-4">
                        <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase">Stream Title</label>
                        <input type="text" name="title" required
                            class="w-full bg-[#0f0f11] border border-gray-700 rounded-lg px-4 py-3 text-gray-200 text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none transition-all placeholder-gray-600"
                            placeholder="Enter stream title" autocomplete="off">
                    </div>

                    <!-- Video Selection Tabs -->
                    <div class="mb-4">
                        <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase">Pemilihan Video</label>
                        <div class="grid grid-cols-2 bg-[#0f0f11] p-1 rounded-lg border border-gray-700 mb-3">
                            <button type="button" onclick="switchVideoModeV2('single')" id="tabSingle"
                                class="py-1.5 text-xs font-bold rounded-md bg-emerald-600 text-white shadow-lg transition-all">SINGLE
                                VIDEO</button>
                            <button type="button" onclick="switchVideoModeV2('playlist')" id="tabPlaylist"
                                class="py-1.5 text-xs font-bold rounded-md text-gray-500 hover:text-gray-300 transition-all">PLAYLIST</button>
                        </div>

                        <!-- GRID VIEW (Single Video) -->
                        <div id="videoSelectionArea">
                            <!-- Search Video -->
                            <!-- Search Video (Hidden/Removed) -->
                            <!-- <div class="relative mb-2"> ... </div> -->

                            <!-- Max height for ~2 rows (approx 80px * 2 + gaps) -->
                            <div id="videoGridContainer"
                                class="grid grid-cols-4 gap-2 max-h-[180px] overflow-y-auto custom-scrollbar p-1">
                                <!-- JS Populated Grid -->
                                <div class="col-span-4 text-center py-4 text-gray-600 italic text-xs">Loading videos
                                    (Grid)...</div>
                            </div>
                        </div>

                        <!-- DROPDOWN VIEW (Playlist) -->
                        <div id="playlistSelectionArea" class="hidden">
                            <div class="relative">
                                <select name="playlistSelect" id="playlistSelect"
                                    class="w-full bg-[#0f0f11] border border-gray-700 rounded-lg px-4 py-3 text-gray-200 text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none appearance-none">
                                    <option value="">Select a Playlist...</option>
                                    <!-- Populated by JS -->
                                </select>
                                <i
                                    class="ti ti-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"></i>
                            </div>
                            <p class="text-[10px] text-gray-500 mt-2 italic">* Playlists must be created in the Playlist
                                Manager</p>
                        </div>
                    </div>

                    <!-- Playback Order -->
                    <!-- Playback Order (Hidden Default: Sequential) -->
                    <input type="hidden" name="playbackOrder" value="sequential">
                </div>

                <!-- CONFIGURATION SECTION -->
                <div class="rounded-xl border border-gray-800 bg-[#18181b] p-5">
                    <div
                        class="flex items-center gap-2 mb-4 text-purple-500 font-bold text-xs tracking-wider uppercase">
                        <i class="ti ti-settings"></i> Konfigurasi Stream
                    </div>

                    <!-- Stream Key / Destination -->
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase">Stream URL
                                (Destination)</label>
                            <input type="text" name="rtmpUrl" required value="rtmp://a.rtmp.youtube.com/live2"
                                class="w-full bg-[#0f0f11] border border-gray-700 rounded-lg px-4 py-3 text-gray-200 text-sm focus:border-purple-500 focus:ring-1 focus:ring-purple-500 outline-none transition-all placeholder-gray-600 font-mono"
                                placeholder="rtmp://..." autocomplete="off">
                        </div>

                        <div>
                            <!-- Hidden Stream Key Logic for Auto-Assign -->
                            <div class="hidden">
                                <select id="streamKeySelect" name="streamKeySelect" class="hidden">
                                    <option value="auto" selected>Auto-Assign (Key Pool)</option>
                                </select>
                            </div>

                            <!-- Category & Privacy Mockups -->
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label
                                        class="block text-xs font-medium text-gray-500 mb-1.5 uppercase">Kategori</label>
                                    <select name="youtube_category" id="youtubeCategorySelect"
                                        class="w-full bg-[#0f0f11] border border-gray-700 rounded-lg px-3 py-2.5 text-gray-200 text-sm outline-none focus:border-purple-500">
                                        <option value="1">Film & Animation</option>
                                        <option value="2">Autos & Vehicles</option>
                                        <option value="10">Music</option>
                                        <option value="15">Pets & Animals</option>
                                        <option value="17">Sports</option>
                                        <option value="19">Travel & Events</option>
                                        <option value="20">Gaming</option>
                                        <option value="22">People & Blogs</option>
                                        <option value="23">Comedy</option>
                                        <option value="24">Entertainment</option>
                                        <option value="25">News & Politics</option>
                                        <option value="26">Howto & Style</option>
                                        <option value="27">Education</option>
                                        <option value="28">Science & Technology</option>
                                        <option value="29">Nonprofits & Activism</option>
                                    </select>
                                </div>
                                <div>
                                    <label
                                        class="block text-xs font-medium text-gray-500 mb-1.5 uppercase">Privasi</label>
                                    <select name="youtube_privacy" id="youtubePrivacySelect"
                                        class="w-full bg-[#0f0f11] border border-gray-700 rounded-lg px-3 py-2.5 text-gray-200 text-sm outline-none focus:border-purple-500">
                                        <option value="public">Public</option>
                                        <option value="unlisted">Unlisted</option>
                                        <option value="private">Private</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Loop & Advanced Settings -->

                        </div>
                    </div>

                </div>
            </div>

            <!-- RIGHT COLUMN (Preview, Thumbnail, Schedule) -->
            <div class="lg:col-span-6 space-y-6">

                <!-- PREVIEW AREA -->
                <div
                    class="aspect-video bg-[#0f0f11] rounded-xl border border-gray-800 overflow-hidden relative group flex items-center justify-center">
                    <div id="videoPreview" class="hidden w-full h-full relative">
                        <!-- Populated JS -->
                    </div>
                    <div id="emptyPreview" class="flex flex-col items-center justify-center text-gray-600">
                        <div class="w-16 h-16 rounded-full bg-gray-800/50 flex items-center justify-center mb-4">
                            <i class="ti ti-video text-2xl"></i>
                        </div>
                        <span class="text-sm font-medium">Select a video to preview</span>
                    </div>
                </div>

                <!-- THUMBNAIL SECTION -->
                <div class="rounded-xl border border-gray-800 bg-[#18181b] p-5">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center gap-2 text-amber-500 font-bold text-xs tracking-wider uppercase">
                            <i class="ti ti-photo"></i> Pilih Thumbnail
                        </div>
                        <span class="text-xs text-gray-600" id="selectedThumbnailName">Selected: None</span>
                    </div>

                    <!-- THUMBNAIL GRID -->
                    <div id="thumbnailGridContainer"
                        class="grid grid-cols-4 gap-3 max-h-[160px] overflow-y-auto custom-scrollbar p-1">
                        <!-- Populated by JS -->
                        <div
                            class="col-span-4 h-24 bg-[#0f0f11] border-2 border-dashed border-gray-800 rounded-lg flex flex-col items-center justify-center text-gray-500">
                            <span class="italic text-xs">No thumbnails available</span>
                        </div>
                    </div>
                </div>

                <!-- Loop & Advanced Settings -->
                <div class="rounded-xl border border-gray-800 bg-[#18181b] p-5">
                    <div
                        class="flex items-center gap-2 mb-4 text-emerald-500 font-bold text-xs tracking-wider uppercase">
                        <i class="ti ti-settings-automation"></i> Pengaturan Tambahan
                    </div>
                    <div class="flex items-center gap-6">
                        <label class="flex items-center gap-2 cursor-pointer group">
                            <div class="relative flex items-center">
                                <input type="checkbox" name="loopVideo" value="true" class="peer hidden" checked>
                                <div
                                    class="w-9 h-5 bg-gray-700 rounded-full peer-checked:bg-emerald-500 transition-colors">
                                </div>
                                <div
                                    class="absolute left-1 top-1 w-3 h-3 bg-white rounded-full peer-checked:translate-x-4 transition-transform">
                                </div>
                            </div>
                            <span
                                class="text-xs font-bold text-gray-400 peer-checked:text-white uppercase tracking-wider">Loop
                                Video</span>
                        </label>

                        <label class="flex items-center gap-2 cursor-pointer group">
                            <div class="relative flex items-center">
                                <input type="checkbox" name="useAdvancedSettings" value="true" class="peer hidden">
                                <div
                                    class="w-9 h-5 bg-gray-700 rounded-full peer-checked:bg-purple-500 transition-colors">
                                </div>
                                <div
                                    class="absolute left-1 top-1 w-3 h-3 bg-white rounded-full peer-checked:translate-x-4 transition-transform">
                                </div>
                            </div>
                            <span
                                class="text-xs font-bold text-gray-400 peer-checked:text-emerald-400 uppercase tracking-wider"
                                title="REQUIRES IDENTICAL VIDEOS">Low CPU Mode (Copy Video)</span>
                        </label>
                    </div>
                </div>

                <!-- SCHEDULE SECTION -->
                <div class="rounded-xl border border-gray-800 bg-[#18181b] p-5">
                    <div class="flex items-center gap-2 mb-4 text-blue-500 font-bold text-xs tracking-wider uppercase">
                        <i class="ti ti-calendar"></i> Pengaturan Jadwal
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase">Start
                                Time</label>
                            <div class="relative">
                                <input type="datetime-local" name="scheduleStartTime" id="scheduleStartTime"
                                    class="w-full bg-[#0f0f11] border border-gray-700 rounded-lg px-4 py-3 text-gray-300 text-sm outline-none focus:border-blue-500 transition-all calendar-picker-indicator-invert">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-500 mb-1.5 uppercase">End Time</label>
                            <div class="relative">
                                <input type="datetime-local" name="scheduleEndTime" id="scheduleEndTime"
                                    class="w-full bg-[#0f0f11] border border-gray-700 rounded-lg px-4 py-3 text-gray-300 text-sm outline-none focus:border-blue-500 transition-all">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <!-- Footer -->
        <div class="px-6 py-2 flex justify-end gap-3 border-t border-gray-800 bg-[#18181b] flex-shrink-0">
            <button type="button" onclick="closeStreamModalV2()"
                class="px-5 py-2 rounded-lg text-xs font-bold text-gray-400 hover:text-white transition-colors">
                Cancel
            </button>
            <button type="button" id="createStreamBtn"
                class="px-6 py-2 rounded-lg text-xs font-bold bg-blue-600 text-white shadow-lg shadow-blue-500/20 hover:bg-blue-500 active:scale-95 transition-all flex items-center gap-2">
                <i class="ti ti-rocket"></i> Create Stream
            </button>
        </div>
    </div>
</div>