                        } catch (e) {
                            console.error(e);
                            window.showToast('error', 'An error occurred during bulk delete');
                            btn.disabled = false;
                            btn.innerHTML = originalHTML;
                        }
                    };

                    window.bulkDownload = async function () {
                        const checkboxes = document.querySelectorAll('.file-checkbox:checked');
                        const ids = Array.from(checkboxes).map(cb => cb.value);
                        if (ids.length === 0) return;

                        if (ids.length === 1) {
                            // Single download
                            window.location.href = `/api/gallery/download/${mediaType}/${ids[0]}`;
                            return;
                        }

                        // Bulk download - prepare as ZIP
                        window.showToast('info', 'Preparing your download. This might take a moment...');

                        try {
                            const res = await fetch('/api/gallery/bulk-download', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-CSRF-Token': csrfToken
                                },
                                body: JSON.stringify({ ids, type: mediaType })
                            });

                            const data = await res.json();
                            if (data.success && data.downloadUrl) {
                                window.location.href = data.downloadUrl;
                            } else {
                                window.showToast('error', data.error || 'Failed to prepare download');
                            }
                        } catch (e) {
                            console.error(e);
                            window.showToast('error', 'Error preparing bulk download');
                        }
                    };
                </script>