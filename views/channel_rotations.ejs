                    window.switchItemModeV3 = function (idx, mode) {
                        const tabVideo = document.getElementById(`tab-video-${idx}`);
                        const tabPlaylist = document.getElementById(`tab-playlist-${idx}`);
                        const videoGrid = document.getElementById(`video-grid-${idx}`);
                        const playlistArea = document.getElementById(`playlist-area-${idx}`);
