<% layout('layout') -%>

    <!-- Header & Navigation -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div class="flex items-center gap-4">
            <a href="/dashboard/<%= channel.slug || channel.id %>"
                class="p-2 bg-dark-700 hover:bg-dark-600 rounded-lg text-gray-400 hover:text-white transition-colors">
                <i class="ti ti-arrow-left text-xl"></i>
            </a>
            <div>
                <h2 class="text-2xl font-bold flex items-center gap-3">
                    Rotations
                    <span
                        class="text-sm font-normal text-gray-400 bg-dark-700 px-2 py-0.5 rounded-md flex items-center gap-1">
                        <img src="<%= channel.thumbnail || '/images/default-channel.png' %>"
                            class="w-4 h-4 rounded-full">
                        <%= channel.name %>
                    </span>
                </h2>
                <p class="text-gray-400 text-sm mt-1">Manage scheduled rotations for this channel</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-3">
            <button id="btnBulkDelete" onclick="bulkDeleteRotations()"
                class="hidden flex-1 md:flex-none flex items-center justify-center gap-2 bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg transition-all shadow-lg shadow-red-500/20 transform hover:scale-105 active:scale-95">
                <i class="ti ti-trash"></i>
                <span>Delete (<span id="selectedCount">0</span>)</span>
            </button>
            <button id="btnGenerateSmart" onclick="generateSmartRotation()"
                class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white px-4 py-2 rounded-lg transition-all shadow-lg shadow-purple-500/20 transform hover:scale-105 active:scale-95">
                <i class="ti ti-brain"></i>
                <span>Generate Smart Rotation</span>
            </button>
            <button onclick="openCreateRotationModal()"
                class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-primary hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-all shadow-lg shadow-primary/20 transform hover:scale-105 active:scale-95">
                <i class="ti ti-plus"></i>
                <span>New Rotation</span>
            </button>
        </div>
    </div>

    <!-- Functional Description Info -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div class="bg-dark-800/40 p-4 rounded-xl border border-blue-500/20 flex gap-4">
            <div class="w-10 h-10 rounded-lg bg-blue-500/10 flex items-center justify-center shrink-0">
                <i class="ti ti-manual-gearbox text-blue-400 text-xl"></i>
            </div>
            <div>
                <h4 class="text-sm font-bold text-blue-400 mb-1">MODE MANUAL (New Rotation)</h4>
                <p class="text-xs text-gray-400 leading-relaxed">
                    Gunakan ini untuk membuat jadwal live yang <strong>tetap dan berulang</strong> setiap harinya.
                    Misal: "Live Pagi" jam 08:00 - 10:00 dengan video/playlist yang Anda pilih sendiri.
                </p>
            </div>
        </div>
        <div class="bg-dark-800/40 p-4 rounded-xl border border-purple-500/20 flex gap-4">
            <div class="w-10 h-10 rounded-lg bg-purple-500/10 flex items-center justify-center shrink-0">
                <i class="ti ti-brain text-purple-400 text-xl"></i>
            </div>
            <div>
                <h4 class="text-sm font-bold text-purple-400 mb-1">MODE SMART (Cerdas Pipen)</h4>
                <p class="text-xs text-gray-400 leading-relaxed">
                    Otomatis membuat jadwal live <strong>acak (5-10 live/hari)</strong> dengan durasi acak (3-7 jam).
                    Sistem menganalisis aktivitas penonton Anda untuk menentukan jam tayang terbaik selama 14 hari ke
                    depan.
                </p>
            </div>
        </div>
    </div>

    <!-- Rotations List -->
    <% if (rotations && rotations.length> 0) { %>
        <!-- Mobile List -->
        <div class="block md:hidden space-y-4">
            <% rotations.forEach(rotation=> { %>
                <div class="bg-dark-800 rounded-xl shadow-md overflow-hidden border border-gray-700/50"
                    data-rotation-id="<%= rotation.id %>">
                    <div class="p-4">
                        <div class="flex gap-4">
                            <div class="relative flex-shrink-0 w-24 h-16 bg-dark-700 rounded-lg overflow-hidden">
                                <% if (rotation.first_thumbnail) { %>
                                    <img src="/uploads/thumbnails/<%= rotation.first_thumbnail.split('/').pop() %>"
                                        class="w-full h-full object-cover" alt="<%= rotation.name %>"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <div class="w-full h-full bg-primary/20 items-center justify-center hidden">
                                        <i class="ti ti-rotate text-primary text-xl"></i>
                                    </div>
                                    <% } else { %>
                                        <div class="w-full h-full bg-primary/20 flex items-center justify-center">
                                            <i class="ti ti-rotate text-primary text-xl"></i>
                                        </div>
                                        <% } %>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h4 class="text-base font-medium text-white truncate leading-tight mb-1">
                                    <%= rotation.name %>
                                </h4>
                                <div class="flex items-center gap-2 text-xs text-gray-400 mb-2">
                                    <span class="bg-dark-700 px-1.5 py-0.5 rounded text-gray-300">
                                        <%= rotation.item_count %> items
                                    </span>
                                    <% if (rotation.repeat_mode==='daily' ) { %>
                                        <span class="text-blue-400">ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢ Daily</span>
                                        <% } %>
                                </div>

                                <% if (rotation.start_time && rotation.end_time) { %>
                                    <div
                                        class="flex items-center gap-2 text-xs font-mono bg-dark-900/50 p-1.5 rounded w-fit">
                                        <span class="text-yellow-500">
                                            <%= new Date(rotation.start_time).toLocaleTimeString('en-US',
                                                {hour: '2-digit' , minute: '2-digit' , hour12: false}) %>
                                        </span>
                                        <span class="text-gray-600">ÃƒÂ¢Ã¢â‚¬Â Ã¢â‚¬â„¢</span>
                                        <span class="text-green-500">
                                            <%= new Date(rotation.end_time).toLocaleTimeString('en-US', {hour: '2-digit'
                                                , minute: '2-digit' , hour12: false}) %>
                                        </span>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Status Bar -->
                    <div class="bg-dark-900/50 px-4 py-2 border-t border-gray-700/50 flex items-center justify-between">
                        <% if (rotation.status==='active' ) { %>
                            <span
                                class="flex items-center text-green-400 text-xs font-medium bg-green-500/10 px-2 py-0.5 rounded-full">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse mr-1.5"></span>
                                Running ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¢ Item <%= (rotation.current_index || 0) + 1 %>/<%=
                                        rotation.item_count %>
                            </span>
                            <% } else if (rotation.status==='paused' ) { %>
                                <span
                                    class="flex items-center text-yellow-400 text-xs font-medium bg-yellow-500/10 px-2 py-0.5 rounded-full">
                                    <i class="ti ti-player-pause mr-1"></i> Paused
                                </span>
                                <% } else { %>
                                    <span
                                        class="flex items-center text-gray-400 text-xs font-medium bg-gray-500/10 px-2 py-0.5 rounded-full">
                                        Inactive
                                    </span>
                                    <% } %>
                    </div>

                    <!-- Actions -->
                    <div class="px-4 py-3 bg-dark-700/20 flex gap-2">
                        <% if (rotation.status !=='active' ) { %>
                            <button onclick="activateRotation('<%= rotation.id %>')"
                                class="flex-1 py-2 bg-green-600 hover:bg-green-500 text-white text-sm font-medium rounded-lg transition-colors flex items-center justify-center gap-1">
                                <i class="ti ti-player-play"></i> Start
                            </button>
                            <% } else { %>
                                <button onclick="stopRotation('<%= rotation.id %>')"
                                    class="flex-1 py-2 bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white border border-red-500/30 text-sm font-medium rounded-lg transition-colors flex items-center justify-center gap-1">
                                    <i class="ti ti-player-stop"></i> Stop
                                </button>
                                <% } %>

                                    <button onclick="editRotation('<%= rotation.id %>')"
                                        class="p-2 bg-dark-700 hover:bg-dark-600 text-gray-300 rounded-lg transition-colors">
                                        <i class="ti ti-edit"></i>
                                    </button>

                                    <% if (rotation.status !=='active' ) { %>
                                        <button onclick="deleteRotation('<%= rotation.id %>')"
                                            class="p-2 bg-dark-700 hover:bg-red-500/20 hover:text-red-400 text-gray-300 rounded-lg transition-colors">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                        <% } %>
                    </div>
                </div>
                <% }); %>
        </div>

        <!-- Desktop Table -->
        <div class="hidden md:block bg-dark-800 rounded-xl shadow-lg border border-gray-700/50 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead class="bg-dark-700/80">
                        <tr>
                            <th class="px-6 py-4 w-10">
                                <div class="flex items-center">
                                    <input type="checkbox" id="selectAllRotations"
                                        class="w-4 h-4 text-primary bg-dark-900 border-gray-700 rounded focus:ring-primary focus:ring-offset-dark-800">
                                </div>
                            </th>
                            <th
                                class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                Rotation Name
                            </th>
                            <th
                                class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                Schedule</th>
                            <th
                                class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                Repeat</th>
                            <th
                                class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                Status</th>
                            <th
                                class="px-6 py-4 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                Current Item
                            </th>
                            <th
                                class="px-6 py-4 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-700/50">
                        <% rotations.forEach(rotation=> { %>
                            <tr class="hover:bg-dark-700/30 transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <input type="checkbox"
                                            class="rotation-checkbox w-4 h-4 text-primary bg-dark-900 border-gray-700 rounded focus:ring-primary focus:ring-offset-dark-800"
                                            value="<%= rotation.id %>">
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-4">
                                        <div
                                            class="w-16 h-10 rounded-lg overflow-hidden flex-shrink-0 bg-dark-900 border border-gray-700 relative group-hover:border-primary/50 transition-colors">
                                            <% if (rotation.first_thumbnail) { %>
                                                <img src="/uploads/thumbnails/<%= rotation.first_thumbnail.split('/').pop() %>"
                                                    alt="" class="w-full h-full object-cover"
                                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                <div
                                                    class="w-full h-full bg-primary/10 items-center justify-center hidden">
                                                    <i class="ti ti-rotate text-primary"></i>
                                                </div>
                                                <% } else { %>
                                                    <div
                                                        class="w-full h-full bg-primary/10 flex items-center justify-center">
                                                        <i class="ti ti-rotate text-primary text-xl"></i>
                                                    </div>
                                                    <% } %>
                                        </div>
                                        <div>
                                            <div
                                                class="text-sm font-medium text-white group-hover:text-primary transition-colors">
                                                <%= rotation.name %>
                                            </div>
                                            <div class="text-xs text-gray-500">
                                                <%= rotation.item_count %> items
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <% if (rotation.start_time && rotation.end_time) { %>
                                        <div class="flex flex-col gap-0.5 text-xs font-mono">
                                            <span class="text-yellow-500">Starts: <%= new
                                                    Date(rotation.start_time).toLocaleTimeString('en-US',
                                                    {hour: '2-digit' , minute: '2-digit' , hour12: false}) %></span>
                                            <span class="text-green-500">Ends: <%= new
                                                    Date(rotation.end_time).toLocaleTimeString('en-US', {hour: '2-digit'
                                                    , minute: '2-digit' , hour12: false}) %></span>
                                        </div>
                                        <% } else { %>
                                            <span class="text-sm text-gray-500">â€”</span>
                                            <% } %>
                                </td>
                                <td class="px-6 py-4">
                                    <% if (rotation.repeat_mode==='daily' ) { %>
                                        <span
                                            class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">Daily</span>
                                        <% } else if (rotation.repeat_mode==='weekly' ) { %>
                                            <span
                                                class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-500/10 text-purple-400 border border-purple-500/20">Weekly</span>
                                            <% } else { %>
                                                <span class="text-gray-500 text-sm">No Repeat</span>
                                                <% } %>
                                </td>
                                <td class="px-6 py-4">
                                    <% if (rotation.status==='active' ) { %>
                                        <span
                                            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-500/10 text-green-400 border border-green-500/20">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
                                            Running
                                        </span>
                                        <% } else if (rotation.status==='paused' ) { %>
                                            <span
                                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">
                                                <i class="ti ti-player-pause"></i> Paused
                                            </span>
                                            <% } else if (rotation.status==='completed' ) { %>
                                                <span
                                                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-blue-500/10 text-blue-400 border border-blue-500/20">
                                                    <i class="ti ti-check"></i> Completed
                                                </span>
                                                <% } else { %>
                                                    <span
                                                        class="px-2.5 py-1 rounded-full text-xs font-medium bg-gray-500/10 text-gray-500 border border-gray-500/20">Inactive</span>
                                                    <% } %>
                                </td>
                                <td class="px-6 py-4">
                                    <% if (rotation.status==='active' ) { %>
                                        <div
                                            class="text-sm bg-dark-900/50 px-2 py-1 rounded border border-gray-700/50 inline-block">
                                            <span class="text-gray-400 text-xs">Playing:</span>
                                            <span class="text-white font-medium ml-1">#<%= (rotation.current_index || 0)
                                                    + 1 %></span>
                                            <span class="text-gray-600 text-xs mx-1">/</span>
                                            <span class="text-gray-400 text-xs">
                                                <%= rotation.item_count %>
                                            </span>
                                        </div>
                                        <% } else { %>
                                            <span class="text-gray-600 text-sm">â€”</span>
                                            <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <% if (rotation.status !=='active' ) { %>
                                            <button onclick="activateRotation('<%= rotation.id %>')"
                                                class="p-1.5 text-green-500 hover:bg-green-500/10 rounded transition-colors"
                                                title="Start Rotation">
                                                <i class="ti ti-player-play"></i>
                                            </button>
                                            <% } else { %>
                                                <button onclick="stopRotation('<%= rotation.id %>')"
                                                    class="p-1.5 text-red-400 hover:bg-red-500/10 rounded transition-colors"
                                                    title="Stop Rotation">
                                                    <i class="ti ti-player-stop"></i>
                                                </button>
                                                <% } %>

                                                    <button onclick="editRotation('<%= rotation.id %>')"
                                                        class="p-1.5 text-blue-400 hover:bg-blue-400/10 rounded transition-colors"
                                                        title="Edit">
                                                        <i class="ti ti-edit"></i>
                                                    </button>

                                                    <% if (rotation.status !=='active' ) { %>
                                                        <button onclick="deleteRotation('<%= rotation.id %>')"
                                                            class="p-1.5 text-gray-400 hover:bg-red-500/10 hover:text-red-400 rounded transition-colors"
                                                            title="Delete">
                                                            <i class="ti ti-trash"></i>
                                                        </button>
                                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="bg-dark-800 rounded-xl p-12 border border-gray-700/50 text-center shadow-lg">
                <div
                    class="w-20 h-20 bg-dark-700/50 rounded-full flex items-center justify-center mx-auto mb-6 ring-4 ring-dark-800">
                    <i class="ti ti-rotate text-4xl text-gray-500"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">No Rotations for <%= channel.name %>
                </h3>
                <p class="text-gray-400 mb-8 max-w-md mx-auto">Create scheduled playlists that automatically switch
                    content
                    based on time slots.</p>
                <button onclick="openCreateRotationModal()"
                    class="px-6 py-3 bg-primary hover:bg-primary-dark text-white rounded-lg inline-flex items-center gap-2 transition-all shadow-lg hover:shadow-primary/20 hover:-translate-y-0.5">
                    <i class="ti ti-plus"></i>
                    <span>Create First Rotation</span>
                </button>
            </div>
            <% } %>

                <!-- Create/Edit Modal -->
                <div id="createRotationModal"
                    class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden modal-overlay">
                    <div class="flex h-full justify-center">
                        <div
                            class="bg-dark-800 shadow-2xl w-full max-w-3xl modal-container flex flex-col h-full border-x border-gray-700 transition-all duration-300 transform translate-y-full opacity-0">

                            <!-- Modal Header -->
                            <div
                                class="flex-shrink-0 flex items-center justify-between px-6 py-2 border-b border-gray-700 bg-dark-900/50 rounded-t-xl">
                                <h3 class="text-lg font-bold text-white flex items-center gap-2"
                                    id="rotationModalTitle">
                                    <i class="ti ti-rotate text-primary"></i> Create New Rotation
                                </h3>
                                <button onclick="closeCreateRotationModal()"
                                    class="text-gray-400 hover:text-white transition-colors p-1 hover:bg-dark-700 rounded-lg">
                                    <i class="ti ti-x text-xl"></i>
                                </button>
                            </div>

                            <!-- Modal Body -->
                            <div class="p-6 overflow-y-auto flex-grow custom-scrollbar">
                                <form id="rotationForm" class="space-y-6">
                                    <input type="hidden" id="rotationId" name="rotationId" value="">

                                    <!-- Hidden Channel ID (Auto-filled) -->
                                    <input type="hidden" id="rotationChannelId" name="rotationChannelId"
                                        value="<%= channel.id %>">

                                    <div class="grid grid-cols-1 gap-6">
                                        <!-- Name Input -->
                                        <div>
                                            <label class="text-sm font-medium text-gray-300 block mb-1.5">Rotation
                                                Name</label>
                                            <input type="text" id="rotationName" name="rotationName"
                                                class="w-full px-4 py-2.5 bg-dark-700 border border-gray-600 rounded-lg text-white focus:border-primary focus:ring-1 focus:ring-primary placeholder-gray-500"
                                                placeholder="e.g., Morning Jazz & Lofi" required>
                                        </div>

                                        <!-- Schedule Section -->
                                        <div class="bg-dark-700/30 p-4 rounded-xl border border-gray-700/50">
                                            <div class="flex items-center justify-between mb-4">
                                                <span class="text-sm font-bold text-white flex items-center gap-2">
                                                    <i class="ti ti-clock text-primary"></i> Schedule Config
                                                </span>
                                                <span id="rotationServerTime"
                                                    class="text-xs font-mono text-gray-400 bg-dark-900 px-2 py-1 rounded border border-gray-700">
                                                    Server: loading...
                                                </span>
                                            </div>

                                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                                <div>
                                                    <label class="text-xs font-medium text-gray-400 block mb-1.5">Start
                                                        Time</label>
                                                    <input type="time" id="rotationStartTime" name="rotationStartTime"
                                                        class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg text-white focus:border-primary [color-scheme:dark]"
                                                        required>
                                                </div>
                                                <div>
                                                    <label class="text-xs font-medium text-gray-400 block mb-1.5">End
                                                        Time</label>
                                                    <input type="time" id="rotationEndTime" name="rotationEndTime"
                                                        class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg text-white focus:border-primary [color-scheme:dark]"
                                                        required>
                                                </div>
                                                <div>
                                                    <label class="text-xs font-medium text-gray-400 block mb-1.5">Repeat
                                                        Mode</label>
                                                    <select id="repeatMode" name="repeatMode"
                                                        class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg text-white focus:border-primary">
                                                        <option value="daily" selected>Daily</option>
                                                        <option value="weekly">Weekly</option>
                                                        <option value="monthly">Monthly</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="mt-3 flex justify-end">
                                                <span id="rotationDurationBadge"
                                                    class="text-xs font-medium text-primary bg-primary/10 px-2 py-1 rounded">Duration:
                                                    00:00</span>
                                            </div>
                                        </div>

                                        <!-- Global Settings -->
                                        <div class="grid grid-cols-2 gap-4">
                                            <div>
                                                <label class="text-sm font-medium text-gray-300 block mb-1.5">Default
                                                    Privacy</label>
                                                <select id="globalPrivacy" name="globalPrivacy"
                                                    class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg text-white text-sm">
                                                    <option value="public">Public</option>
                                                    <option value="unlisted" selected>Unlisted</option>
                                                    <option value="private">Private</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="text-sm font-medium text-gray-300 block mb-1.5">Default
                                                    Category</label>
                                                <select id="globalCategory" name="globalCategory"
                                                    class="w-full px-3 py-2 bg-dark-700 border border-gray-600 rounded-lg text-white text-sm">
                                                    <option value="10">Music</option>
                                                    <option value="20">Gaming</option>
                                                    <option value="22">People & Blogs</option>
                                                    <option value="24">Entertainment</option>
                                                    <option value="28">Science & Technology</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Rotation Items -->
                                    <div class="border-t border-gray-700 pt-6">
                                        <div class="flex justify-between items-center mb-4">
                                            <h4 class="text-sm font-bold text-white flex items-center gap-2">
                                                <i class="ti ti-playlist text-blue-400"></i> Playlist Items
                                            </h4>
                                            <span class="text-xs text-gray-500">Drag items to reorder (Coming
                                                Soon)</span>
                                        </div>

                                        <div id="rotationItemsContainer" class="space-y-4 mb-4">
                                            <!-- Items injected JS -->
                                        </div>

                                        <button type="button" onclick="addRotationItem()"
                                            class="w-full py-3 bg-dark-700/50 hover:bg-dark-700 border-2 border-dashed border-gray-600 hover:border-gray-500 text-gray-400 hover:text-white rounded-xl transition-all flex items-center justify-center gap-2 group">
                                            <div
