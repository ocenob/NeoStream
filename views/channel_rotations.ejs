                        modeInput.value = mode;

                        if (mode === 'video') {
                            tabVideo.classList.add('tab-active');
                            tabVideo.classList.remove('text-gray-500');
                            tabPlaylist.classList.remove('tab-active');
                            tabPlaylist.classList.add('text-gray-500');
                            videoGrid.classList.remove('hidden');
                            playlistArea.classList.add('hidden');
                        } else {
                            tabPlaylist.classList.add('tab-active');
                            tabPlaylist.classList.remove('text-gray-500');
                            tabVideo.classList.remove('tab-active');
                            tabVideo.classList.add('text-gray-500');
