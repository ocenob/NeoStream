                    window.selectThumbnailForItemV3 = function (idx, path, element) {
                        const wrapper = document.querySelector(`.rotation-item[data-index="${idx}"]`);
                        wrapper.querySelector('.thumbnail-path-input').value = path;

                        // UI Feedback
                        wrapper.querySelectorAll(`.thumb-card-${idx}`).forEach(card => {
                            card.classList.remove('item-selected');
                            card.querySelector('.v2-check-marker').classList.add('hidden');
                        });
                        element.classList.add('item-selected');
                        element.querySelector('.v2-check-marker').classList.remove('hidden');

                        // Preview
                        const previewImg = document.getElementById(`item-thumb-preview-${idx}`);
                        const previewWrap = document.getElementById(`item-thumb-preview-wrap-${idx}`);
                        const label = document.getElementById(`item-thumb-label-${idx}`);

                        const displayUrl = path.startsWith('/') ? path : `/uploads/thumbnails/${path.split('/').pop()}`;
                        previewImg.src = displayUrl;
                        previewWrap.classList.remove('hidden');
