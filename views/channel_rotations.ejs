                <script type="application/json" id="v_data"><%- JSON.stringify(videos || []) %></script>
                <script type="application/json" id="p_data"><%- JSON.stringify(playlists || []) %></script>
                <script type="application/json" id="t_data"><%- JSON.stringify(thumbnails || {}) %></script>
                <script>
                    const videos = JSON.parse(document.getElementById('v_data').textContent);
                    const playlists = JSON.parse(document.getElementById('p_data').textContent);
                    const thumbnails = JSON.parse(document.getElementById('t_data').textContent);
                    const csrfToken = '<%= csrfToken %>';
                    let rotationItemCount = 0;

                    // -- Server Time --
                    // -- Server Time -- (Handled by layout.ejs)
                    function updateRotationServerTime() {
                        const el = document.getElementById('rotationServerTime');
                        if (!el) return;
                        const clockEl = document.getElementById('server-clock');
                        if (clockEl) el.textContent = `Server: ${clockEl.textContent}`;
                    }
                    setInterval(updateRotationServerTime, 1000);
                    console.log("DEBUG: channel_rotations.ejs loaded - Server clock sync enabled");

                    // -- Duration --
                    window.calculateDuration = function () {
                        const start = document.getElementById('rotationStartTime').value;
                        const end = document.getElementById('rotationEndTime').value;
                        const badge = document.getElementById('rotationDurationBadge');

                        if (!start || !end) {
                            badge.textContent = 'Duration: 00:00';
                            return;
                        }

                        const [h1, m1] = start.split(':').map(Number);
                        const [h2, m2] = end.split(':').map(Number);
                        let min1 = h1 * 60 + m1;
                        let min2 = h2 * 60 + m2;

                        if (min2 <= min1) min2 += 24 * 60;

                        const diff = min2 - min1;
                        const h = Math.floor(diff / 60);
                        const m = diff % 60;

                        badge.textContent = `Duration: ${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
                    }
                    document.getElementById('rotationStartTime').addEventListener('change', calculateDuration);
                    document.getElementById('rotationEndTime').addEventListener('change', calculateDuration);

                    // -- Toast --
                    function showToast(type, message) {
                        const toast = document.getElementById('toast');
                        const icon = document.getElementById('toast-icon');
                        const msg = document.getElementById('toast-message');
                        if (!toast || !icon || !msg) return;

                        toast.classList.remove('hidden', 'border-green-500/50', 'border-red-500/50');

                        if (type === 'success') {
                            icon.className = 'ti ti-check text-green-500';
                            toast.classList.add('border-green-500/50');
                        } else {
                            icon.className = 'ti ti-alert-triangle text-red-500';
                            toast.classList.add('border-red-500/50');
                        }

                        msg.textContent = message;
                        toast.classList.add('active');

                        setTimeout(() => {
                            toast.classList.remove('active');
                            setTimeout(() => toast.classList.add('hidden'), 300);
                        }, 3000);
                    }

                    // -- Modal --
                    window.openCreateRotationModal = function () {
                        const modal = document.getElementById('createRotationModal');
                        const modalContainer = modal.querySelector('.modal-container');
                        document.getElementById('rotationModalTitle').innerHTML = '<i class="ti ti-rotate text-primary"></i> Create New Rotation';
                        document.getElementById('rotationForm').reset();
                        document.getElementById('rotationId').value = '';
                        document.getElementById('rotationChannelId').value = '<%= channel.id %>'; // Ensure ID is persistent
                        document.getElementById('rotationDurationBadge').textContent = 'Duration: 00:00';
                        updateRotationServerTime();

                        document.getElementById('rotationItemsContainer').innerHTML = '';
                        rotationItemCount = 0;
                        // Don't add default item if we're just about to fill it (like in edit)
                        // But for "New", we want one.
                        if (document.getElementById('rotationId').value === '') {
                            addRotationItem();
                        }

                        document.body.style.overflow = 'hidden';
                        modal.classList.remove('hidden');
                        setTimeout(() => {
                            if (modalContainer) modalContainer.classList.add('active');
                        }, 10);
                    }

                    window.closeCreateRotationModal = function () {
                        const modal = document.getElementById('createRotationModal');
                        const modalContainer = modal.querySelector('.modal-container');
                        if (modalContainer) modalContainer.classList.remove('active');
                        setTimeout(() => {
                            modal.classList.add('hidden');
                            document.body.style.overflow = '';
                        }, 300);
                    }

                    window.generateSmartRotation = function () {
                        // Open configuration modal instead of direct confirm
                        const modal = document.getElementById('smartConfigModal');
                        const modalContainer = modal.querySelector('.modal-container');
                        document.body.style.overflow = 'hidden';
                        modal.classList.remove('hidden');
                        setTimeout(() => {
                            if (modalContainer) modalContainer.classList.add('active');
                        }, 10);
                    }

                    window.closeSmartConfigModal = function () {
                        const modal = document.getElementById('smartConfigModal');
                        const modalContainer = modal.querySelector('.modal-container');
                        if (modalContainer) modalContainer.classList.remove('active');
                        setTimeout(() => {
                            modal.classList.add('hidden');
                            document.body.style.overflow = '';
                        }, 300);
                    }

                    // -- Batch Mode Logic --
                    let currentSmartTab = 'single';

                    window.switchSmartTab = function (mode) {
                        currentSmartTab = mode;
                        document.getElementById('tab-single').className = mode === 'single' ?
                            'flex-1 py-1.5 text-xs font-bold rounded-md transition-all bg-purple-600 text-white shadow-lg' :
                            'flex-1 py-1.5 text-xs font-bold rounded-md transition-all text-gray-400 hover:text-white hover:bg-dark-700';

                        document.getElementById('tab-batch').className = mode === 'batch' ?
                            'flex-1 py-1.5 text-xs font-bold rounded-md transition-all bg-purple-600 text-white shadow-lg' :
                            'flex-1 py-1.5 text-xs font-bold rounded-md transition-all text-gray-400 hover:text-white hover:bg-dark-700';

                        document.getElementById('panel-single').classList.toggle('hidden', mode !== 'single');
                        document.getElementById('panel-batch').classList.toggle('hidden', mode !== 'batch');
                    }

                    // Slider Listener
                    const slider = document.getElementById('batchCountSlider');
                    if (slider) {
                        slider.addEventListener('input', function (e) {
                            document.getElementById('batchCountDisplay').innerText = e.target.value + 'x';
                        });
                    }

                    window.autoDetectBestTimes = async function () {
                        const btn = event.currentTarget || document.activeElement;
                        const originalText = btn.innerHTML;
                        btn.disabled = true;
                        btn.innerHTML = '<i class="ti ti-loader animate-spin"></i> Detecting...';

                        const count = document.getElementById('batchCountSlider').value;
                        const channelId = document.getElementById('rotationChannelId').value;
                        const region = document.getElementById('targetRegion') ? document.getElementById('targetRegion').value : 'GLOBAL';

                        try {
                            const res = await fetch(`/api/channels/${channelId}/best-hours?count=${count}&region=${region}`);
                            const data = await res.json();

                            if (data.success) {
                                // Check for NO_DATA explicitly
                                if (data.message === 'NO_DATA') {
                                    showToast('error', 'No Viewer Data found in Analytics (Last 30 Days)');
                                    document.getElementById('batchSlotsContainer').innerHTML = '<span class="text-amber-500 text-xs italic">No viewer data available. Try Manual Mode.</span>';
                                    return;
                                }

                                // Check for fallback warning
                                if (data.fallback) {
                                    showToast('error', data.message || 'Analytics API Error');
                                }

                                // Update array
                                const times = data.hours || [];
                                document.getElementById('batchStartTimesJson').value = JSON.stringify(times);

                                // Render tags
                                const container = document.getElementById('batchSlotsContainer');
                                container.innerHTML = '';
                                if (times.length === 0) {
                                    container.innerHTML = '<span class="text-amber-500 text-xs italic">No data found.</span>';
                                } else {
                                    times.forEach(t => {
                                        container.innerHTML += `<span class="bg-purple-500/20 text-purple-300 border border-purple-500/30 px-2 py-1 rounded text-xs font-mono font-bold">${t}</span>`;
                                    });
                                }

                                if (!data.fallback) {
                                    showToast('success', `Found ${times.length} best times from Analytics!`);
                                }
                            } else {
                                // Handle Specific Backend Errors
                                if (data.error) {
                                    showToast('error', data.error);
                                } else {
                                    showToast('error', 'Failed to detect times');
                                }
                            }
                        } catch (e) {
                            console.error(e);
                            showToast('error', 'Network error');
                        } finally {
                            btn.disabled = false;
                            btn.innerHTML = originalText;
                        }
                    }

                    // -- Weekly Pattern Toggle --
                    window.toggleWeeklyPattern = function () {
                        const active = document.getElementById('weeklyPatternToggle').checked;
                        document.getElementById('standardCountControl').classList.toggle('hidden', active);
                        document.getElementById('weeklyRangeControl').classList.toggle('hidden', !active);

                        // Auto-toggle repeats mode logic
                        // If Weekly Pattern is ON, we force repeat mode to Weekly? Actually backend handles this.
                        // But users might want to see. For now, backend will override repeatMode to 'weekly' if pattern is active.
                    }

                    window.confirmSmartGeneration = async function () {
                        const form = document.getElementById('smartScheduleForm');
                        const formData = new FormData(form);

                        const data = {
                            minDurationHours: formData.get('minDurationHours'),
                            maxDurationHours: formData.get('maxDurationHours'),
                            targetItemCount: formData.get('targetItemCount'),
                            sourcePlaylistId: formData.get('sourcePlaylistId'),
                            customTitles: formData.get('customTitles').split('\n').map(t => t.trim()).filter(t => t),
                            customDescription: formData.get('customDescription'),
                            customTags: formData.get('customTags'),
                            postLiveTitles: formData.get('postLiveTitles') ? formData.get('postLiveTitles').split('\n').map(t => t.trim()).filter(t => t) : [],
                            postLiveThumbnailMode: formData.get('postLiveThumbnailMode') || 'none',
                            postLiveDelayDays: parseInt(formData.get('postLiveDelayDays') || 0),
                            postLiveCtrThreshold: parseFloat(formData.get('postLiveCtrThreshold') || 0),
                            privacy: formData.get('privacy'),
                            repeatMode: formData.get('repeatMode')
                        };

                        // Mode Specific
                        if (currentSmartTab === 'batch') {
                            const timesJson = document.getElementById('batchStartTimesJson').value;
                            let startTimes = [];
                            try { startTimes = JSON.parse(timesJson); } catch (e) { }

                            const weeklyActive = document.getElementById('weeklyPatternToggle').checked;

                            // startTimes is optional, backend uses defaults if empty

                            data.startTimes = startTimes;
                            // Removed crashed redundant duration accesses

                            // Weekly Pattern Params
                            data.weeklyPattern = weeklyActive;
                            if (weeklyActive) {
                                data.minDailyStreams = document.getElementById('minDailyStreams').value;
                                data.maxDailyStreams = document.getElementById('maxDailyStreams').value;
                            } else {
                                // Standard count implies we just use the generated startTimes length
                                // data.targetDailyStreams = ... (already implicit in startTimes array)
                            }

                        } else {
                            // Single Mode
                            data.startTime = formData.get('startTime');
                            data.durationHours = formData.get('durationHours');
                        }

                        const channelId = document.getElementById('rotationChannelId').value;
                        if (!channelId) return showToast('error', 'No YouTube channel selected');

                        if (!data.sourcePlaylistId || data.sourcePlaylistId === '') {
                            return showToast('error', 'Please select a source playlist');
                        }

                        closeSmartConfigModal();

                        const btn = document.getElementById('btnGenerateSmart');
                        const originalHTML = btn.innerHTML;
                        btn.disabled = true;
                        btn.innerHTML = '<i class="ti ti-loader animate-spin"></i> Generating...';

                        try {
                            const res = await fetch(`/api/channels/${channelId}/generate-smart-rotation`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-CSRF-Token': csrfToken
                                },
                                body: JSON.stringify(data)
                            });
                            const result = await res.json();

                            if (result.success) {
                                showToast('success', result.message);
                                setTimeout(() => location.reload(), 1500);
                            } else {
                                showToast('error', result.error || 'Generation failed');
                                btn.disabled = false;
                                btn.innerHTML = originalHTML;
                            }
                        } catch (e) {
                            console.error(e);
                            showToast('error', 'Network error occurred');
                            btn.disabled = false;
                            btn.innerHTML = originalHTML;
                        }
                    }

                    // -- Format Duration Helper --
                    function formatDuration(seconds) {
                        if (!seconds) return '';
                        const h = Math.floor(seconds / 3600);
                        const m = Math.floor((seconds % 3600) / 60);
                        const s = Math.floor(seconds % 60);
                        if (h > 0) return `${h}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                        return `${m}:${s.toString().padStart(2, '0')}`;
                    }

