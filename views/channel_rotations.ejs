                    }


                    // -- Save Logic --
                    window.saveRotation = async function () {
                        const form = document.getElementById('rotationForm');
                        const items = [];
                        const rotationId = document.getElementById('rotationId').value;

                        // Collect Data
                        document.querySelectorAll('.rotation-item').forEach(el => {
                            const idx = el.dataset.index;
                            items.push({
                                video_id: el.querySelector('.video-id-input').value,
                                title: el.querySelector('.title-input').value,
                                description: el.querySelector('textarea').value,
                                tags: el.querySelector('.tags-input').value,
                                privacy: document.getElementById('globalPrivacy').value,
                                category: document.getElementById('globalCategory').value,
                                thumbnail_path: el.querySelector('.thumbnail-path-input').value,
                                original_thumbnail_path: el.dataset.originalThumbnail || null
                            });
                        });

                        // Validation
                        if (!document.getElementById('rotationName').value) return showToast('error', 'Rotation Name is required');
                        if (items.length === 0) return showToast('error', 'Add at least one item');

                        let valid = true;
                        items.forEach((item, i) => {
                            if (!item.video_id) { valid = false; showToast('error', `Item #${i + 1}: Select content`); }
                            if (!item.title) { valid = false; showToast('error', `Item #${i + 1}: Title required`); }
                        });
                        if (!valid) return;

                        // Build FormData
                        const fd = new FormData();
                        fd.append('name', document.getElementById('rotationName').value);
                        fd.append('repeat_mode', document.getElementById('repeatMode').value);
                        fd.append('youtube_channel_id', document.getElementById('rotationChannelId').value);

                        // Date Construction
                        const dateStr = new Date().toISOString().split('T')[0];
                        fd.append('start_time', dateStr + 'T' + document.getElementById('rotationStartTime').value + ':00');
                        fd.append('end_time', dateStr + 'T' + document.getElementById('rotationEndTime').value + ':00');


                        const finalItems = [];
                        document.querySelectorAll('.rotation-item').forEach(el => {
                            const fileInput = el.querySelector('.thumbnail-input');

                            finalItems.push({
                                video_id: el.querySelector('.video-id-input').value,
                                title: el.querySelector('.title-input').value,
                                description: el.querySelector('textarea').value,
                                tags: el.querySelector('.tags-input').value,
                                privacy: document.getElementById('globalPrivacy').value,
                                category: document.getElementById('globalCategory').value,
                                thumbnail_path: el.querySelector('.thumbnail-path-input').value || null,
                                original_thumbnail_path: el.dataset.originalThumbnail || null,
                                post_live_title: el.querySelector('.post-live-title-input').value || null,
                                post_live_thumbnail_path: el.querySelector('.post-live-thumbnail-path-input').value || null
                            });

                            // Always append something to thumbnails array to keep index sync
                            if (fileInput.files[0]) {
                                fd.append('thumbnails', fileInput.files[0]);
                            } else {
                                // Use empty.jpg instead of empty.txt to satisfy Multer image validation
                                fd.append('thumbnails', new File([], 'empty.jpg', { type: 'image/jpeg' }));
                            }
                        });


                        fd.append('items', JSON.stringify(finalItems));

                        // Send
                        const url = rotationId ? `/api/rotations/${rotationId}` : '/api/rotations';
                        const method = rotationId ? 'PUT' : 'POST';

                        try {
                            const res = await fetch(url, {
                                method: method,
                                headers: { 'X-CSRF-Token': csrfToken },
                                body: fd
                            });
                            const data = await res.json();
                            if (data.success) {
                                showToast('success', 'Saved Successfully');
                                setTimeout(() => window.location.reload(), 1000);
                            } else {
                                showToast('error', data.error || 'Save failed');
                            }
                        } catch (e) {
                            console.error(e);
                            showToast('error', 'Network error');
                        }
                    }

                    // -- Edit / Delete / Actoins --
                    window.editRotation = async function (id) {
                        try {
                            const res = await fetch(`/api/rotations/${id}`);
                            const data = await res.json();
                            if (data.success) {
                                const r = data.rotation;
                                openCreateRotationModal();
                                document.getElementById('rotationModalTitle').innerHTML = '<i class="ti ti-edit text-blue-400"></i> Edit Rotation';
                                document.getElementById('rotationId').value = r.id;
                                document.getElementById('rotationName').value = r.name;
                                document.getElementById('repeatMode').value = r.repeat_mode;

                                // Time
                                const formatT = (d) => {
                                    if (!d) return "";
                                    let date = new Date(d);
                                    if (isNaN(date.getTime())) return "";
                                    return String(date.getHours()).padStart(2, '0') + ':' + String(date.getMinutes()).padStart(2, '0');
                                };
                                document.getElementById('rotationStartTime').value = formatT(r.start_time);
                                document.getElementById('rotationEndTime').value = formatT(r.end_time);
                                if (typeof calculateDuration === 'function') calculateDuration();

                                // Items
                                document.getElementById('rotationItemsContainer').innerHTML = '';
                                rotationItemCount = 0;

                                if (Array.isArray(r.items)) {
                                    r.items.forEach(item => {
                                        try {
                                            addRotationItem();
                                            const idx = rotationItemCount;
                                            const el = document.getElementById('rotationItemsContainer').lastElementChild;

                                            // Content Selection
                                            const vId = String(item.video_id || "");
                                            if (vId.startsWith('playlist:')) {
                                                const pid = vId.split(':')[1];
                                                switchItemModeV3(idx, 'playlist');
                                                const select = el.querySelector('select');
                                                if (select) select.value = pid;
                                                selectPlaylistForItem(idx, pid);
                                            } else if (vId) {
                                                switchItemModeV3(idx, 'video');
                                                const card = el.querySelector(`.video-card-${idx}[data-video-id="${vId}"]`);
                                                if (card) {
                                                    selectVideoForItemV3(idx, vId, card, item.title);
                                                } else {
                                                    el.querySelector('.video-id-input').value = vId;
                                                }
                                            }

                                            // Re-apply Title/Desc/Tags AFTER content selection to prevent overwrite
                                            if (item.title) el.querySelector('.title-input').value = item.title;
                                            if (item.description) el.querySelector('textarea').value = item.description;
                                            if (item.tags) el.querySelector('.tags-input').value = item.tags;

                                            // Thumbnail
                                            if (item.thumbnail_path) {
                                                const tPath = item.thumbnail_path;
                                                const tCard = el.querySelector(`.thumb-card-${idx}[data-path="${tPath}"]`);
                                                if (tCard) {
                                                    selectThumbnailForItemV3(idx, tPath, tCard);
                                                } else {
                                                    el.querySelector('.thumbnail-path-input').value = tPath;
                                                    el.dataset.originalThumbnail = tPath;
                                                    const previewImg = document.getElementById(`item-thumb-preview-${idx}`);
                                                    const previewWrap = document.getElementById(`item-thumb-preview-wrap-${idx}`);
                                                    const label = document.getElementById(`item-thumb-label-${idx}`);
                                                    if (previewImg && previewWrap && label) {
                                                        const filename = tPath.split(/[\\/]/).pop();
                                                        previewImg.src = `/uploads/thumbnails/${filename}`;
                                                        previewWrap.classList.remove('hidden');
                                                        label.textContent = "Saved";
                                                    }
                                                }
                                            }

                                            // Post-Live Metadata
                                            if (item.post_live_title) el.querySelector('.post-live-title-input').value = item.post_live_title;
                                            if (item.post_live_thumbnail_path) {
                                                const plTPath = item.post_live_thumbnail_path;
                                                const plTCard = el.querySelector(`.post-live-thumb-card-${idx}[data-path="${plTPath}"]`);
                                                if (plTCard) {
                                                    selectPostLiveThumbnailForItem(idx, plTPath, plTCard);
                                                } else {
                                                    el.querySelector('.post-live-thumbnail-path-input').value = plTPath;
                                                }
                                            }
                                        } catch (err) {
                                            console.error('Error populating item:', err);
                                        }
                                    });
                                }

                            }
                        } catch (e) { console.error(e); showToast('error', 'Failed to load'); }
                    }

                    window.deleteRotation = async function (id) {
                        if (!(await showConfirm('Delete this rotation?'))) return;
                        await fetch(`/api/rotations/${id}`, { method: 'DELETE', headers: { 'X-CSRF-Token': csrfToken } });
                        window.location.reload();
                    }

                    window.activateRotation = async function (id) {
                        await fetch(`/api/rotations/${id}/activate`, { method: 'POST', headers: { 'X-CSRF-Token': csrfToken } });
                        window.location.reload();
                    }

                    window.stopRotation = async function (id) {
                        await fetch(`/api/rotations/${id}/stop`, { method: 'POST', headers: { 'X-CSRF-Token': csrfToken } });
                        window.location.reload();
                    };

                    // -- Bulk Delete Logic --
                    (function () {
                        function updateBtn() {
                            const count = document.querySelectorAll('.rotation-checkbox:checked').length;
                            const btn = document.getElementById('btnBulkDelete');
                            const countSpan = document.getElementById('selectedCount');
                            if (btn && countSpan) {
                                countSpan.textContent = count;
                                if (count > 0) btn.classList.remove('hidden');
                                else btn.classList.add('hidden');
                            }
                        }

                        function initBulkDelete() {
                            const selectAllCheckbox = document.getElementById('selectAllRotations');
                            if (selectAllCheckbox) {
                                selectAllCheckbox.addEventListener('change', function () {
                                    document.querySelectorAll('.rotation-checkbox').forEach(cb => cb.checked = this.checked);
                                    updateBtn();
                                });
                            }
                            document.addEventListener('change', (e) => {
                                if (e.target.classList.contains('rotation-checkbox')) {
                                    updateBtn();
                                    if (selectAllCheckbox) {
                                        const all = document.querySelectorAll('.rotation-checkbox').length;
                                        const checked = document.querySelectorAll('.rotation-checkbox:checked').length;
                                        selectAllCheckbox.checked = (all > 0 && all === checked);
                                    }
                                }
                            });
                            updateBtn();
                        }

                        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initBulkDelete);
                        else initBulkDelete();
                    })();

                    window.bulkDeleteRotations = async function () {
                        const selected = Array.from(document.querySelectorAll('.rotation-checkbox:checked')).map(cb => cb.value);
                        if (selected.length === 0) return;

                        if (!(await showConfirm(`Delete ${selected.length} selected rotations? This cannot be undone.`))) return;

                        const btn = document.getElementById('btnBulkDelete');
                        const originalContent = btn.innerHTML;
                        btn.innerHTML = '<i class="ti ti-loader animate-spin"></i> Deleting...';
                        btn.disabled = true;

                        try {
                            const res = await fetch('/api/rotations/bulk-delete', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-CSRF-Token': csrfToken
                                },
                                body: JSON.stringify({ ids: selected })
                            });
                            const data = await res.json();

                            if (data.success) {
                                showToast('success', `Deleted ${data.deletedCount} rotations`);
                                setTimeout(() => window.location.reload(), 500);
                            } else {
                                showToast('error', data.error || 'Delete failed');
                                btn.innerHTML = originalContent;
                                btn.disabled = false;
                            }
                        } catch (e) {
                            console.error(e);
                            showToast('error', 'Network error');
                            btn.innerHTML = originalContent;
                            btn.disabled = false;
                        }
                    }

                    // Auto-open modal if requested via URL
                    window.addEventListener('DOMContentLoaded', () => {
                        const urlParams = new URLSearchParams(window.location.search);
                        if (urlParams.get('action') === 'create') {
                            // Clean URL
                            const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
                            window.history.replaceState({ path: newUrl }, '', newUrl);

                            // Open Modal
                            if (typeof openCreateRotationModal === 'function') {
                                openCreateRotationModal();
                            }
                        }
                    });
